<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="163ty (generated)">
        <!-- Создание таблицы chat -->
        <createTable tableName="chat" schemaName="public">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6)"/>
            <column name="title" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="002" author="163ty (generated)">
        <!-- Создание таблицы chat_entry -->
        <createTable tableName="chat_entry" schemaName="public">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="content" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP(6)"/>
            <column name="role" type="VARCHAR(255)"/>
            <column name="chat_id" type="BIGINT"/>
        </createTable>

        <!-- Добавление внешнего ключа -->
        <addForeignKeyConstraint baseTableName="chat_entry"
                                 baseColumnNames="chat_id"
                                 constraintName="fk_chat_entry_chat"
                                 referencedTableName="chat"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>